<Window x:Class="UnityLingo.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="UnityLingo · 设置" Width="880" Height="740" MinWidth="760" MinHeight="650" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/>
    <TabControl x:Name="Tabs" Grid.Row="1" Background="White" Padding="16">
      <TabItem Header="  模型配置  ">
        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="新增" Click="AddModel_Click"/><Button Content="删除" Click="DeleteModel_Click" Margin="0"/></WrapPanel><ListBox x:Name="Models" DisplayMemberPath="Name" SelectionChanged="Model_Selected"/></DockPanel>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ModelForm">
            <TextBlock Text="配置名称" Style="{StaticResource Caption}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="API Base URL" Style="{StaticResource Caption}"/><TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="例如 https://api.example.com/v1，不含 /chat/completions" TextWrapping="Wrap" Foreground="#738098" FontSize="12" Margin="0,5,0,0"/>
            <TextBlock Text="模型 ID" Style="{StaticResource Caption}"/><TextBox Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="API Key" Style="{StaticResource Caption}"/><PasswordBox x:Name="ApiKey" PasswordChanged="Key_Changed"/>
            <TextBlock Text="Key 仅在本机加密保存。每次请求发送至上方地址。" TextWrapping="Wrap" Foreground="#738098" FontSize="12" Margin="0,6,0,0"/>
            <WrapPanel Margin="0,20,0,0"><Button Content="测试连接" Click="Test_Click"/><Button x:Name="CancelTest" Content="取消测试" Click="CancelTest_Click" IsEnabled="False"/></WrapPanel>
            <TextBlock Text="测试会发送一次简短请求，可能产生少量 API 费用。" TextWrapping="Wrap" Foreground="#738098" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="  场景提示词  ">
        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DockPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="新增" Click="AddScenario_Click"/><Button Content="复制" Click="DuplicateScenario_Click" Margin="0"/><Button Content="删除" Click="DeleteScenario_Click" Margin="0,8,0,0"/></WrapPanel><ListBox x:Name="Scenarios" DisplayMemberPath="Name" SelectionChanged="Scenario_Selected"/></DockPanel>
          <Grid x:Name="ScenarioForm" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="场景名称" Style="{StaticResource Caption}"/><TextBox Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="2" Text="输出类型" Style="{StaticResource Caption}"/><ComboBox x:Name="OutputType" Grid.Row="3" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding OutputKind}"/>
            <TextBlock Grid.Row="4" Text="场景提示词（每次请求都会携带）" Style="{StaticResource Caption}"/>
            <TextBox Grid.Row="5" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="6" Margin="0,12,0,0"><Button Content="恢复此内置场景的默认设置" Click="ResetScenario_Click" HorizontalAlignment="Left"/><TextBlock Text="输出格式和命名规则由程序附加，无需写 JSON 模板。" TextWrapping="Wrap" FontSize="12" Foreground="#738098" Margin="0,8,0,0"/></StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="  历史与存储  ">
        <StackPanel Margin="12,22"><CheckBox x:Name="HistoryEnabled" Content="在本地保存成功生成的历史记录"/>
          <TextBlock Text="历史记录上限（条）" Style="{StaticResource Caption}"/><TextBox x:Name="HistoryLimit" HorizontalAlignment="Left" Width="220"/>
          <TextBlock Text="默认 200 条，可随时调整。超过上限会删除最旧的记录。&#10;调低上限时会先显示需要删除的数量，由你确认。&#10;关闭保存不会删除已有记录。" TextWrapping="Wrap" Foreground="#59677F" Margin="0,12,0,0" LineHeight="25"/>
          <TextBlock Text="本地数据目录" Style="{StaticResource Caption}"/><TextBox x:Name="DataPath" IsReadOnly="True" TextWrapping="Wrap"/>
          <TextBlock Text="历史包括输入、上下文和结果，以本地数据库保存，不另行同步云端。&#10;正常生成时，当前输入、上下文与场景提示词会发送给你配置的模型服务。" TextWrapping="Wrap" Foreground="#59677F" Margin="0,16,0,0" LineHeight="25"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Foreground="#59677F" Margin="0,14,0,12"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click"/><Button Content="关闭" Click="Close_Click" Margin="0"/></StackPanel>
  </Grid>
</Window>
