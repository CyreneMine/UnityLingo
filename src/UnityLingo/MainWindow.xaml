<Window x:Class="UnityLingo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="UnityLingo · 开发者的翻译助手" Width="1120" Height="780" MinWidth="880" MinHeight="650" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="HistoryButton" Content="历史记录" Click="History_Click"/><Button x:Name="SettingsButton" Content="设置" Click="Settings_Click" Margin="0"/>
      </StackPanel>
      <StackPanel><TextBlock Text="UnityLingo" FontSize="28" FontWeight="Bold"/><TextBlock Text="把你的想法，变成开发中的准确表达。" Foreground="#59677F" Margin="0,5,0,0"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,18">
      <Grid x:Name="OptionsPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0"><TextBlock Text="使用场景" Margin="0,0,0,6"/><ComboBox x:Name="ScenarioBox" SelectionChanged="Scenario_Changed" AutomationProperties.Name="使用场景"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="当前模型" Margin="0,0,0,6"/><ComboBox x:Name="ModelBox" AutomationProperties.Name="当前模型" SelectionChanged="Model_Changed"/></StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="ModeLabel" Text="命名对象" Margin="0,0,0,6"/>
          <ComboBox x:Name="NamingBox" SelectedIndex="1" AutomationProperties.Name="命名对象"><ComboBoxItem Content="局部变量"/><ComboBoxItem Content="字段"/><ComboBoxItem Content="属性"/><ComboBoxItem Content="方法"/><ComboBoxItem Content="类"/></ComboBox>
          <ComboBox x:Name="LanguageBox" SelectedIndex="0" Visibility="Collapsed" AutomationProperties.Name="目标语言"><ComboBoxItem Content="自动 · 中英互译"/><ComboBoxItem Content="译成简体中文"/><ComboBoxItem Content="译成英文"/></ComboBox>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="你想表达什么？" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <TextBox x:Name="InputBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="输入文本"/>
          <TextBlock Grid.Row="2" Text="补充上下文（可选） · 例如：角色移动速度，float 字段" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
          <TextBox x:Name="ContextBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="补充上下文"/>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="GenerateButton" Content="生成  Ctrl + Enter" Style="{StaticResource PrimaryButton}" Click="Generate_Click"/><Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="Cancel_Click"/></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14"><Button x:Name="CopyButton" DockPanel.Dock="Right" Content="复制结果" IsEnabled="False" Click="Copy_Click" Margin="0"/><TextBlock Text="生成结果" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="从一个词、一句话开始。&#10;&#10;命名模式会给出推荐名称、备选和解释。&#10;先在设置中添加你的模型和 API Key。" TextWrapping="Wrap" Foreground="#738098" VerticalAlignment="Center" HorizontalAlignment="Center" LineHeight="26"/>
          <TextBox x:Name="TranslationOutput" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0" Padding="0" AutomationProperties.Name="翻译结果"/>
          <ScrollViewer x:Name="NamingOutput" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Suggestions"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="#F3F6FE" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel><TextBlock Text="{Binding Label}" Foreground="#2563EB" FontSize="12" Margin="0,0,0,8"/>
                  <DockPanel><Button Content="复制" DockPanel.Dock="Right" Tag="{Binding Name}" Click="CopyName_Click" Margin="8,0,0,0" Padding="10,4"/><TextBox Text="{Binding Name, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"/></DockPanel>
                  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#59677F" Margin="0,10,0,0" LineHeight="22"/>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,16,0,0"><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8"/><TextBlock x:Name="StatusText" Text="就绪 · 每次仅发送当前输入与上下文" Foreground="#59677F" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</Window>
